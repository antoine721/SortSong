generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  spotifyUserId     String    @unique
  name              String
  email             String?
  image             String?
  product           String?
  accessTokenEnc    String
  refreshTokenEnc   String
  accessExpiresAt   DateTime
  authorizedAt      DateTime  @default(now())
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  library           LibraryTrack[]
  folders           Folder[]
  playlists         Playlist[]
  tags              Tag[]
}

model Track {
  id          String   @id @default(cuid())
  spotifyId   String   @unique
  title       String
  artists     String   // JSON [{id,name}]
  artistNames String   // "A, B" pour recherche/tri
  album       String
  albumId     String?
  coverUrl    String?
  coverSmall  String?
  durationMs  Int
  isrc        String?
  deezerId    String?
  bpm         Float?
  bpmSource   String?  // deezer | manual
  key         String?  // Camelot ex. 8A
  energy      Int?     // 1-5
  explicit    Boolean  @default(false)
  releaseDate String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  library     LibraryTrack[]
  playlists   PlaylistTrack[]
  tags        TrackTag[]

  @@index([isrc])
}

model LibraryTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  source    String   // liked | playlist | search
  sourceRef String?  // nom de la playlist Spotify d'origine
  status    String   @default("inbox") // inbox | sorted | dismissed
  addedAt   DateTime // date d'ajout côté Spotify si connue
  firstSeen DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, status])
}

model Folder {
  id        String     @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  position  Int        @default(0)
  collapsed Boolean    @default(false)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]   @relation("FolderTree")
  playlists Playlist[]
}

model Playlist {
  id          String          @id @default(cuid())
  userId      String
  folderId    String?
  name        String
  color       String          @default("#1db954")
  description String?
  position    Int             @default(0)
  hotkey      Int?            // 1-9
  rules       String?         // JSON (playlist intelligente)
  spotifyExportId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tracks      PlaylistTrack[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Float
  note       String?
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([trackId])
}

model Tag {
  id       String     @id @default(cuid())
  userId   String
  name     String
  category String     @default("genre") // genre | subgenre | mood | moment | vocal
  color    String     @default("#8b5cf6")
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks   TrackTag[]

  @@unique([userId, name, category])
}

model TrackTag {
  trackId String
  tagId   String
  track   Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([trackId, tagId])
}

model SimilarCache {
  id        String   @id @default(cuid())
  seedKey   String   @unique // spotifyId du morceau de départ
  results   String   // JSON [spotifyId]
  createdAt DateTime @default(now())
}

model ArtistCache {
  key       String   @id
  data      String
  createdAt DateTime @default(now())
}
