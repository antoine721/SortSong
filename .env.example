# Copier en .env puis remplir.
DATABASE_URL="file:./dev.db"

# Tableau de bord Spotify : https://developer.spotify.com/dashboard
# Redirect URI à déclarer EXACTEMENT : http://127.0.0.1:3000/api/auth/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/auth/callback"

# Clé de chiffrement des jetons (32+ caractères aléatoires) : openssl rand -hex 32
APP_SECRET=""

# Last.fm (gratuit) : https://www.last.fm/api/account/create — utilisé pour « Mix inspiré de » et artistes proches
LASTFM_API_KEY=""
