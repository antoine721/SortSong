# Tout est FACULTATIF : sans ce fichier, l'app crée une base SQLite locale et
# te guide dans l'écran /setup pour saisir le Client ID Spotify et la clé Last.fm.
# Une variable définie ici est prioritaire sur la valeur saisie dans l'app.

# Base de données : SQLite par défaut ; une URL postgres:// bascule automatiquement sur Postgres.
DATABASE_URL="file:./dev.db"

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=""
# Par défaut : <adresse de l'app>/api/auth/callback
SPOTIFY_REDIRECT_URI=""

# Last.fm (https://www.last.fm/api/account/create)
LASTFM_API_KEY=""
LASTFM_SHARED_SECRET=""

# Clé de chiffrement des jetons ; générée et stockée en base si absente.
APP_SECRET=""
