{
  "name": "sortsong",
  "version": "1.0.0",
  "private": true,
  "description": "Surcouche Spotify pour DJ : écouter, ranger, retrouver et découvrir des morceaux.",
  "scripts": {
    "dev": "node scripts/prepare-db.mjs && next dev -H 127.0.0.1 -p 3000",
    "build": "node scripts/prepare-db.mjs --generate && next build",
    "start": "node scripts/prepare-db.mjs && next start -H ${HOST:-127.0.0.1} -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/prepare-db.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-virtual": "3.13.12",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
